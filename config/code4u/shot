#!/usr/bin/env bash
# CODE4U · capturas
#   shot region   → seleccionas un área
#   shot window   → ventana activa
#   shot screen   → pantalla completa
#   shot edit     → seleccionas un área y abre directo el editor (satty)
# Siempre: guarda en ~/Pictures/Capturas, copia al portapapeles, suena y avisa.
set -u
DIR="$HOME/Pictures/Capturas"; mkdir -p "$DIR"
FILE="$DIR/CODE4U_$(date +%F_%H%M%S).png"
SFX="$HOME/.config/code4u/sfx/play"
slurp_c4(){ slurp -b 0d0f2488 -c e33a8eff -s e33a8e1a -w 2 -B 0d0f2400 "$@"; }

case "${1:-region}" in
  region|edit) GEO=$(slurp_c4) || exit 0; grim -g "$GEO" "$FILE" ;;
  window)      GEO=$(hyprctl activewindow -j | python3 -c 'import json,sys;w=json.load(sys.stdin);print(f"{w[\"at\"][0]},{w[\"at\"][1]} {w[\"size\"][0]}x{w[\"size\"][1]}")' 2>/dev/null)
               [ -n "$GEO" ] && grim -g "$GEO" "$FILE" || grim "$FILE" ;;
  screen)      grim "$FILE" ;;
  *) echo "uso: shot region|window|screen|edit"; exit 1 ;;
esac
[ -s "$FILE" ] || exit 1

wl-copy --type image/png < "$FILE"
"$SFX" shot &

edit(){ command -v satty >/dev/null && satty --filename "$FILE" --output-filename "$FILE" \
        || notify-send -a CAPTURA "FALTA SATTY" "Instala el editor:  sudo pacman -S satty"; }

[ "${1:-}" = edit ] && { edit; exit 0; }

SIZE=$(python3 -c "import struct,sys;f=open(sys.argv[1],'rb');f.seek(16);w,h=struct.unpack('>II',f.read(8));print(f'{w}×{h}')" "$FILE")
ACT=$(notify-send -a CAPTURA -i camera-photo \
      -A edit="EDITAR" -A open="CARPETA" -A del="BORRAR" \
      "CAPTURA · $SIZE" "Copiada al portapapeles · $(basename "$FILE")<img src=\"$FILE\" alt=\"captura\"/>")
case "$ACT" in
  edit) edit ;;
  open) xdg-open "$DIR" ;;
  del)  rm -f "$FILE"; wl-copy --clear ;;
esac

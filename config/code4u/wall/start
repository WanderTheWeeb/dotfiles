#!/usr/bin/env bash
# CODE4U · fondo: animado con mpvpaper si está instalado, si no el PNG estático con hyprpaper.
#   start          → arranca el que toque
#   start static   → fuerza el estático (ahorra batería)
VID="$HOME/.config/hypr/wall/code4u-loop.mp4"

pkill -x mpvpaper 2>/dev/null
if [ "${1:-}" != static ] && command -v mpvpaper >/dev/null && [ -f "$VID" ]; then
    setsid mpvpaper -p -o "no-audio loop hwdec=vaapi panscan=1.0 vo=gpu profile=fast" '*' "$VID" >/dev/null 2>&1 &
    sleep 1.5; pkill -x hyprpaper 2>/dev/null
else
    pgrep -x hyprpaper >/dev/null || setsid hyprpaper >/dev/null 2>&1 &
fi

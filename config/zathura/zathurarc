# CODE4U · zathura (PDFs) — paleta ruta nocturna
set font                    "MartianMono Nerd Font 10"
set default-bg              "rgba(13,15,36,0.92)"
set default-fg              "#f2ead8"
set statusbar-bg            "#12153a"
set statusbar-fg            "#aab4f2"
set statusbar-h-padding     14
set statusbar-v-padding     6
set inputbar-bg             "#1b1f4a"
set inputbar-fg             "#f2ead8"
set notification-bg         "#1b1f4a"
set notification-fg         "#f2ead8"
set notification-error-bg   "#d8323c"
set notification-error-fg   "#f2ead8"
set notification-warning-bg "#f2c76b"
set notification-warning-fg "#0d0f24"
set completion-bg           "#12153a"
set completion-fg           "#aab4f2"
set completion-group-bg     "#0d0f24"
set completion-group-fg     "#6b79d6"
set completion-highlight-bg "#e33a8e"
set completion-highlight-fg "#f2ead8"
set index-bg                "#0d0f24"
set index-fg                "#aab4f2"
set index-active-bg         "#5a1f45"
set index-active-fg         "#f2ead8"
set highlight-color         "rgba(242,199,107,0.35)"
set highlight-active-color  "rgba(227,58,142,0.45)"
set highlight-fg            "#0d0f24"

# modo noche (Ctrl+R): el PDF con fondo azul noche y letras crema
set recolor                 true
set recolor-lightcolor      "#0d0f24"
set recolor-darkcolor       "#f2ead8"
set recolor-keephue         true
set recolor-reverse-video   true

set selection-clipboard     clipboard
set adjust-open             "width"
set scroll-page-aware       true
set smooth-scroll           true
set window-title-basename   true
set guioptions              "sv"
set page-padding            6
set render-loading-bg       "#12153a"
set render-loading-fg       "#e33a8e"

map <C-r> recolor
map u scroll half-up
map d scroll half-down
map D toggle_page_mode
map i recolor

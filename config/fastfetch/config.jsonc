{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/code4u.txt",
    "color": { "1": "blue", "2": "magenta" },
    "padding": { "top": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "magenta", "title": "blue" }
  },
  "modules": [
    { "type": "custom", "format": "\u001b[95m▌ PRÓXIMA SALIDA · ANDÉN 1 · BIENVENIDO A BORDO" },
    "title",
    { "type": "separator", "string": "─" },
    { "type": "os",       "key": "ruta     " },
    { "type": "wm",       "key": "línea    " },
    { "type": "uptime",   "key": "viaje    " },
    { "type": "packages", "key": "pasajeros", "format": "{all} (pacman)" },
    { "type": "memory",   "key": "carga    " },
    { "type": "battery",  "key": "fuel     ", "format": "{capacity}" },
    { "type": "cpu",      "key": "motor    ", "format": "{name}" },
    { "type": "kernel",   "key": "kernel   " },
    { "type": "terminal", "key": "terminal " },
    "break",
    "colors"
  ]
}

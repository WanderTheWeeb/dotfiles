{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "positionX": "right",
  "positionY": "top",
  "layer": "overlay",
  "control-center-layer": "top",
  "layer-shell": true,
  "layer-shell-cover-screen": true,
  "cssPriority": "user",
  "control-center-margin-top": 6,
  "control-center-margin-bottom": 10,
  "control-center-margin-right": 6,
  "notification-2fa-action": true,
  "notification-inline-replies": true,
  "notification-icon-size": 48,
  "notification-body-image-height": 198,
  "notification-body-image-width": 352,
  "timeout": 7,
  "timeout-low": 4,
  "timeout-critical": 0,
  "fit-to-screen": true,
  "relative-timestamps": true,
  "control-center-width": 440,
  "control-center-height": 720,
  "notification-window-width": 420,
  "keyboard-shortcuts": true,
  "notification-grouping": true,
  "image-visibility": "when-available",
  "transition-time": 220,
  "hide-on-clear": true,
  "hide-on-action": true,
  "text-empty": "SIN AVISOS",
  "script-fail-notify": false,
  "scripts": {
    "sfx-chime":    { "app-name": "^(?!OSD$|SFX$).*", "urgency": "Normal",   "exec": "sh -c '~/.config/code4u/sfx/play chime'" },
    "sfx-low":      { "app-name": "^(?!OSD$|SFX$).*", "urgency": "Low",      "exec": "sh -c '~/.config/code4u/sfx/play ws'" },
    "sfx-alert":    { "urgency": "Critical", "exec": "sh -c '~/.config/code4u/sfx/play alert'" }
  },
  "notification-visibility": {},
  "widgets": ["title", "dnd", "mpris", "volume", "backlight", "notifications"],
  "widget-config": {
    "title":  { "text": "AVISOS · ANDÉN", "clear-all-button": true, "button-text": "LIMPIAR" },
    "dnd":    { "text": "NO MOLESTAR" },
    "mpris":  { "autohide": true, "show-album-art": "always", "loop-carousel": false },
    "volume": { "label": "VOL", "show-per-app": false },
    "backlight": { "label": "LUZ", "device": "intel_backlight" },
    "notifications": { "vexpand": true }
  }
}
